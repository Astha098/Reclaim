# Copy to .env and edit. Every value below has a working default — the system
# runs end to end with this file absent.

# --- Razorpay -----------------------------------------------------------------
# Leave USE_MOCK_RAZORPAY=true to run without an account. The mock mirrors the
# real API's request validation and response shapes, so flipping this to false
# with test keys should require no other code change.
USE_MOCK_RAZORPAY=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret configured on the Razorpay webhook. The demo seeder signs
# its own events with this, so it stays consistent either way.
RAZORPAY_WEBHOOK_SECRET=whsec_local_dev
VERIFY_WEBHOOK_SIGNATURE=true

# --- Classifier ---------------------------------------------------------------
# hybrid = rules first, LLM only for what rules can't place (recommended)
# rules   = zero network calls, fully deterministic
# llm     = force the model on every payment; used by the eval to measure how
#           much the rules were actually carrying
CLASSIFIER_MODE=hybrid
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Below this confidence the LLM's answer is discarded in favour of UNKNOWN.
# Abstaining is cheaper than acting on a wrong bucket.
LLM_ABSTAIN_BELOW=0.55

# --- Guardrails ---------------------------------------------------------------
# A ceiling over every bucket's own cap, so lowering this clamps the taxonomy.
# 3 is the highest any bucket asks for (technical); set it to 2 and you have
# quietly overridden that policy.
MAX_ATTEMPTS_PER_ORDER=3
MIN_COOLDOWN_MINUTES=30
QUIET_HOURS_START=21
QUIET_HOURS_END=8
MAX_CONTACTS_PER_CUSTOMER_PER_DAY=2
MAX_CONTACTS_PER_MERCHANT_PER_DAY=5000

# --- Circuit breaker ----------------------------------------------------------
HEALTH_WINDOW_MINUTES=15
# Don't open a circuit on a handful of samples — low-volume issuers would flap.
HEALTH_MIN_SAMPLES=20
HEALTH_OPEN_BELOW=0.35
HEALTH_CLOSE_ABOVE=0.60
HEALTH_HALF_OPEN_AFTER_MINUTES=5
HEALTH_PROBE_ATTEMPTS=5

# --- Runtime ------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
SCHEDULER_TICK_SECONDS=10
# Divides every scheduled delay, so a 4-day payday-aligned retry fires in minutes
# during a live demo. Set to 1 for real timing.
DEMO_TIME_COMPRESSION=240
DASHBOARD_ORIGIN=http://localhost:5173
